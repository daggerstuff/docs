# Linear workspace audit — environment configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Linear GraphQL API key (required for live fetch, audit, and webhook operations)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxx

# Optional: Linear team ID (defaults to the Pixelated workspace team)
LINEAR_TEAM_ID=52861523-9089-49a3-8be5-4032d68cb55a

# Optional: Linear GraphQL API URL (defaults to https://api.linear.app/graphql)
LINEAR_API_URL=https://api.linear.app/graphql

# Optional: Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=

# Optional: webhook secret auto-generated by register_webhook.py (verify webhook signatures)
LINEAR_DASHBOARD_WEBHOOK_SECRET=
